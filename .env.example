# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Scraper Configuration
SCRAPER_TIMEOUT=15
SCRAPER_DEADLINE=25
SCRAPER_RATE_LIMIT=0.0
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BACKOFF=1.5
SCRAPER_WARMUP=True
SCRAPER_USE_CURL_CFFI=True
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# API Configuration
API_RATE_LIMIT_PER_MINUTE=10
API_LOG_RATE_LIMIT_PER_MINUTE=120
API_LOG_CLEAR_RATE_LIMIT_PER_MINUTE=30
API_MAX_RESULTS=100
# Comma separated list; empty means "allow any origin"
CORS_ORIGINS=

# Logging
LOG_LEVEL=INFO
LOG_MAX_ENTRIES=1000

# Flask-Limiter storage. "memory://" is per-process; use redis://... for
# multiple workers so limits are actually shared.
RATELIMIT_STORAGE_URI=memory://
